# Copy this file to .env and fill in real values to use live Twitch data.
# Without these set, the server runs in MOCK_MODE with fake channels so you
# can see everything working before setting up a Twitch developer app.

# Get these free at https://dev.twitch.tv/console/apps -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch category to pull live channels from (exact name, e.g. "Just Chatting")
TWITCH_CATEGORY=Just Chatting

# How long to stay on a channel before auto-jumping, in seconds
JUMP_INTERVAL_SECONDS=45

# Port the server runs on
PORT=3000
